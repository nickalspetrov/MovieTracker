@page "/movies/{Id:guid}"
@inject MovieApiClient MovieApiClient
@inject NavigationManager Navigation

<PageTitle>@(movie?.Title ?? "Movie details")</PageTitle>

@if (isLoading)
{
    <section class="state-panel"><h1>Loading movie...</h1></section>
}
else if (errorMessage is not null)
{
    <section class="state-panel error-panel" role="alert"><h1>We couldn't load this movie</h1><p>@errorMessage</p><button class="button" @onclick="LoadMovieAsync">Try again</button></section>
}
else if (movie is null)
{
    <section class="state-panel"><h1>Movie not found</h1><p>This movie is no longer available.</p><NavLink class="button" href="movies">Back to movies</NavLink></section>
}
else
{
    <section class="details-hero page-section">
        <img src="@movie.PosterUrl" alt="Abstract poster for @movie.Title" />
        <div>
            <span class="genre-badge">@(movie.Genre == "ScienceFiction" ? "Science Fiction" : movie.Genre)</span>
            <h1>@movie.Title</h1>
            <p class="details-meta">@movie.ReleaseYear</p>
            <p class="details-description">@movie.Description</p>
            <NavLink class="button" href="movies">Back to movies</NavLink>
            <NavLink class="button" href="@($"movies/{movie.Id}/edit")">Edit movie</NavLink>
            @if (!confirmDelete)
            {
                <button class="button" @onclick="() => confirmDelete = true">Delete movie</button>
            }
            else
            {
                <div role="group" aria-label="Confirm deletion">
                    <p>Delete @movie.Title? This cannot be undone.</p>
                    <button class="button" disabled="@isDeleting" @onclick="DeleteAsync">@(isDeleting ? "Deleting..." : "Confirm delete")</button>
                    <button class="quiet-button" disabled="@isDeleting" @onclick="() => confirmDelete = false">Cancel</button>
                </div>
            }
            @if (deleteError is not null) { <p role="alert" class="form-message">@deleteError</p> }
        </div>
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private MovieListItemModel? movie;
    private bool isLoading = true;
    private string? errorMessage;
    private int loadVersion;
    private bool confirmDelete;
    private bool isDeleting;
    private string? deleteError;

    private async Task DeleteAsync()
    {
        if (isDeleting) return;
        isDeleting = true;
        deleteError = null;
        try
        {
            await MovieApiClient.DeleteMovieAsync(Id);
            Navigation.NavigateTo("/movies");
        }
        catch (MovieApiException exception) { deleteError = exception.Message; }
        catch (Exception) { deleteError = "The movie service is unavailable. Please try again."; }
        finally { isDeleting = false; }
    }

    protected override Task OnParametersSetAsync() => LoadMovieAsync();

    private async Task LoadMovieAsync()
    {
        var version = ++loadVersion;
        confirmDelete = false;
        deleteError = null;
        isLoading = true;
        errorMessage = null;
        movie = null;
        try
        {
            var result = await MovieApiClient.GetMovieAsync(Id);
            if (version == loadVersion) movie = result;
        }
        catch (Exception)
        {
            if (version == loadVersion) errorMessage = "The movie service is unavailable. Please try again.";
        }
        finally
        {
            if (version == loadVersion) isLoading = false;
        }
    }
}
